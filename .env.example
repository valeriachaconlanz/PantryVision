# Copy to .env and fill in. Never commit real keys.

# Backend (Spring Boot)
LLM_API_KEY=
RECIPE_API_KEY=

# Only needed with SPRING_PROFILES_ACTIVE=postgres
DB_URL=jdbc:postgresql://localhost:5432/pantryvision
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Frontend (Vite) - optional, defaults to /api
VITE_API_BASE_URL=
