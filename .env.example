# Copy this file to .env and fill it in. Don't commit your .env!

# Backend
LLM_API_KEY=
RECIPE_API_KEY=

# Supabase database (only needed with SPRING_PROFILES_ACTIVE=supabase)
# Get these from Supabase: Connect button > Session pooler. Ask Valeria for the password.
# Example URL: jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=
# Looks like postgres.abcdefghijklmnop (the part after the dot is the project ref)
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Frontend (you can leave this blank)
VITE_API_BASE_URL=
